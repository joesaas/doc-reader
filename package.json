{"dependencies":{"cors":"^2.8.5","express":"^4.21.2","lucide-react":"^0.469.0","multer":"^1.4.5-lts.1","react":"^19.0.0","react-dom":"^19.0.0"},"description":"文档阅读平台：按分类管理、阅读 answer-me-with-html 等工具生成的 HTML 文档","devDependencies":{"@tailwindcss/vite":"^4.0.0","@types/cors":"^2.8.17","@types/express":"^4.17.21","@types/multer":"^1.4.12","@types/node":"^22.10.2","@types/react":"^19.0.2","@types/react-dom":"^19.0.2","@vitejs/plugin-react":"^4.3.4","concurrently":"^9.1.0","tailwindcss":"^4.0.0","tsx":"^4.19.2","typescript":"^5.7.2","vite":"^6.0.5"},"engines":{"node":">=20"},"name":"doc-reader","private":true,"scripts":{"build":"tsc -p tsconfig.server.json && vite build --config vite.config.ts","dev":"concurrently -k -n server,client \"tsx watch server/src/index.ts\" \"vite --config vite.config.ts\"","dev:client":"vite --config vite.config.ts","dev:server":"tsx watch server/src/index.ts","import:am":"tsx scripts/import-am.ts","smoke":"node scripts/smoke.mjs","start":"node dist/server/src/index.js","typecheck":"tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"},"type":"module","version":"0.1.0"}